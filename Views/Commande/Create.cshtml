@model BrasilBurger.CSharp.Models.Commande
@{
    ViewData["Title"] = "Créer une commande";
}

<h2>Créer une commande</h2>

<form method="post">
    <div class="form-group">
        <label>Client ID :</label>
        <input type="number" name="ClientId" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Type (LIVRAISON / RETRAIT) :</label>
        <input type="text" name="TypeRetrait" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Adresse de livraison :</label>
        <input type="text" name="AdresseLivraison" class="form-control" />
    </div>
    <div class="form-group">
        <label>Zone ID :</label>
        <input type="number" name="ZoneId" class="form-control" />
    </div>
    <div class="form-group">
        <label>Total :</label>
        <input type="number" step="0.01" name="Total" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Payé ? (true/false) :</label>
        <input type="text" name="Paye" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Créer</button>
</form>
