@model BrasilBurger.CSharp.Models.Commande
@{
    ViewData["Title"] = "Modifier une commande";
}

<h2>Modifier la commande #@Model.Id</h2>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="form-group">
        <label>Statut (EN_COURS / LIVREE / ANNULEE) :</label>
        <input type="text" name="Statut" class="form-control" value="@Model.Statut" />
    </div>
    <div class="form-group">
        <label>Payé ? (true/false) :</label>
        <input type="text" name="Paye" class="form-control" value="@Model.Paye" />
    </div>
    <div class="form-group">
        <label>Adresse :</label>
        <input type="text" name="AdresseLivraison" class="form-control" value="@Model.AdresseLivraison" />
    </div>
    <div class="form-group">
        <label>Zone ID :</label>
        <input type="number" name="ZoneId" class="form-control" value="@Model.ZoneId" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Enregistrer</button>
</form>
