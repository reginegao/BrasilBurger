@model BrasilBurger.CSharp.Models.Burger
@{
    ViewData["Title"] = "Modifier un Burger";
}

<h1>Modifier un Burger</h1>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <label>Nom :</label>
    <input type="text" name="Nom" value="@Model.Nom" required />
    <br/>
    <label>Prix :</label>
    <input type="number" step="0.01" name="Prix" value="@Model.Prix" required />
    <br/>
    <label>Image URL :</label>
    <input type="text" name="ImageUrl" value="@Model.ImageUrl" />
    <br/>
    <button type="submit">Enregistrer</button>
</form>
<a href="/Burger/Index">Annuler</a>
