@model BrasilBurger.CSharp.Models.Menu
@{
    ViewData["Title"] = "Modifier un Menu";
}

<h2>Modifier un Menu</h2>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="form-group">
        <label>Nom :</label>
        <input type="text" name="Nom" class="form-control" value="@Model.Nom" required />
    </div>
    <div class="form-group">
        <label>Prix :</label>
        <input type="number" step="0.01" name="Prix" class="form-control" value="@Model.Prix" required />
    </div>
    <div class="form-group">
        <label>Image URL :</label>
        <input type="text" name="ImageUrl" class="form-control" value="@Model.ImageUrl" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Enregistrer</button>
</form>
