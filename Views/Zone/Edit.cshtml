@model BrasilBurger.CSharp.Models.Zone
@{
    ViewData["Title"] = "Modifier une zone";
}

<h2>Modifier une zone</h2>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="form-group">
        <label>Nom :</label>
        <input type="text" name="Nom" class="form-control" value="@Model.Nom" required />
    </div>
    <div class="form-group">
        <label>Prix Livraison :</label>
        <input type="number" step="0.01" name="PrixLivraison" class="form-control" value="@Model.PrixLivraison" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Enregistrer</button>
</form>
