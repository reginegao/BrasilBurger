@model BrasilBurger.CSharp.Models.Zone
@{
    ViewData["Title"] = "Créer une zone";
}

<h2>Créer une zone</h2>

<form method="post">
    <div class="form-group">
        <label>Nom :</label>
        <input type="text" name="Nom" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Prix Livraison :</label>
        <input type="number" step="0.01" name="PrixLivraison" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Créer</button>
</form>
