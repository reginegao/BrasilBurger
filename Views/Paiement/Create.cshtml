@model BrasilBurger.CSharp.Models.Paiement
@{
    ViewData["Title"] = "Créer un paiement";
}

<h2>Créer un paiement</h2>

<form method="post">
    <div class="form-group">
        <label>Commande ID :</label>
        <input type="number" name="CommandeId" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Montant :</label>
        <input type="number" step="0.01" name="Montant" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Méthode (WAVE / OM) :</label>
        <input type="text" name="Methode" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Créer</button>
</form>
